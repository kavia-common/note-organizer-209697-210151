# Backend configuration

# DATABASE_URL should point to the Postgres DB.
# The notes_database container startup defaults to:
#   postgresql://appuser:dbuser123@localhost:5000/myapp
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# JWT secret used to sign access tokens (set a strong random value in production).
JWT_SECRET=change_me_super_secret

# Token expiry in seconds (e.g., 86400 = 24h)
JWT_EXPIRES_IN=86400

# Comma-separated list of allowed frontend origins for CORS.
# Example: http://localhost:3000
CORS_ORIGINS=http://localhost:3000
